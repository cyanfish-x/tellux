# rclone远程配置名称
# 先执行 rclone config 创建同名 remote，例如 my-cloud-server:
RCLONE_REMOTE=my-cloud-server

# 文件路径(绝对路径)
LOCAL_DIR="your/local/dir"
REMOTE_DIR="your/remote/dir"

# rclone同步参数
RCLONE_TRANSFERS=8
RCLONE_CHECKERS=16

# CDN操作授权信息
CDN_SECRET_ID="yourid"
CDN_SECRET_KEY="yourkey"
CDN_FLUSH_PATHS="https://demo.example.com/"

# Cloudflare Pages Direct Upload（不要 Connect Git）
# 本机用 `pnpm exec wrangler login` 即可，不必填 token / account id
CLOUDFLARE_PAGES_PROJECT="your-pages-project"
# 可选。无 wrangler login 时（例如 CI）才需要：
# CLOUDFLARE_API_TOKEN="your-api-token"
# CLOUDFLARE_ACCOUNT_ID="your-account-id"
# 可选。Direct Upload 用这个名字选择 production / preview，默认 main
# CLOUDFLARE_PAGES_BRANCH=main
