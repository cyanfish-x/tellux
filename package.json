{
  "name": "tellux",
  "version": "0.2.0",
  "description": "An open-source 3D Earth Engine built on Three.js for digital globes, digital twins, 3D maps, and modern web applications.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    }
  },
  "scripts": {
    "build": "vite build && node actions/copy-assets.js && tsc -p tsconfig.types.json",
    "build:examples": "vitepress build docs && vite build --config examples/vite.config.ts",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs --host 0.0.0.0 --port 5174",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 4174 --strictPort",
    "preview": "vite preview --config examples/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest",
    "test:run": "vitest run",
    "benchmark:hism": "node scripts/hism-benchmark.mjs",
    "check:showcase": "node scripts/check-showcase-links.mjs",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "dev": "node scripts/dev.mjs",
    "generate:msdf": "node scripts/generate-msdf-atlas.js",
    "deploy": "npm run build:examples && node actions/deploy.js",
    "deploy:ghpages": "node actions/deploy-ghpages.mjs",
    "prepublishOnly": "pnpm type-check && pnpm build",
    "changelog": "node actions/generate-changelog.js --dry-run",
    "release:check": "pnpm type-check && pnpm build && pnpm pack --dry-run",
    "release": "node actions/release.js patch",
    "release:patch": "node actions/release.js patch",
    "release:minor": "node actions/release.js minor",
    "release:major": "node actions/release.js major",
    "prepare": "husky"
  },
  "peerDependencies": {
    "3d-tiles-renderer": "^0.4.27",
    "@mapbox/vector-tile": "^2.0.3",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-clouds": "0.7.6",
    "@takram/three-geospatial": "0.9.1",
    "@takram/three-geospatial-effects": "0.6.4",
    "pbf": "^4.0.1",
    "postprocessing": "6.39.1",
    "three": "^0.184.0"
  },
  "peerDependenciesMeta": {
    "@mapbox/vector-tile": {
      "optional": true
    },
    "pbf": {
      "optional": true
    }
  },
  "devDependencies": {
    "3d-tiles-renderer": "^0.4.27",
    "3d-tiles-rendererjs-3dgs-plugin": "^0.1.13",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@mapbox/vector-tile": "^2.0.5",
    "@sparkjsdev/spark": "^2.1.0",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-clouds": "0.7.6",
    "@takram/three-geospatial": "0.9.1",
    "@takram/three-geospatial-effects": "0.6.4",
    "@types/node": "^18.18.12",
    "@types/three": "^0.184.1",
    "concurrently": "^9.2.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "monaco-editor": "^0.52.2",
    "msdf-bmfont-xml": "^2.8.0",
    "pbf": "^4.0.2",
    "postprocessing": "6.39.1",
    "rimraf": "^6.0.1",
    "three": "^0.184.0",
    "typescript": "~5.2.2",
    "vite": "^5.4.19",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9",
    "playwright": "^1.49.0",
    "tencentcloud-sdk-nodejs-cdn": "^4.1.200"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@mapbox/tiny-sdf": "^2.2.0",
    "dotenv": "^17.4.2",
    "three-mesh-bvh": "0.9.0"
  }
}
